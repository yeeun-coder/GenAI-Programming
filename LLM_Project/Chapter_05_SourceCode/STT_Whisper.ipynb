from openai import OpenAI
from dotenv import load_dotenv
import os

load_dotenv()
strGPT_API_Key = os.getenv('OPENAI_API_KEY')
client = OpenAI(api_key=strGPT_API_Key)


audio_file_path = '../Data/Audio_Boohwal.mp3' # MP3 file path

with open(audio_file_path, 'rb') as audio_file:
    transcription = client.audio.transcriptions.create(
        model="whisper-1",
        file=audio_file
    )

transcription

# 실행 결과 : Transcription(text='이제 너에게 난 아픔이란 걸 너를 사랑하면 알수록 멀리 떠나가도 스치듯 시간의 흐름 속에', usage={'type': 'duration', 'seconds': 30})


audio_file_path = '../Data/Audio_Boohwal.mp3' # MP3 file path

with open(audio_file_path, 'rb') as audio_file:
    transcription = client.audio.translations.create(
        model="whisper-1",
        file=audio_file
    )

transcription

